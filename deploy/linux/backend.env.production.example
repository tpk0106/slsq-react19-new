# Copy to /opt/slsq/app/slsq-backend/.env on the Ubuntu server and fill in values.
# Never commit the real file. (Coolify keeps using its own env vars.)
NODE_ENV=production
PORT=5000
DB_SERVER=127.0.0.1
DB_NAME=slsq
DB_USER=slsq_app
DB_PASSWORD=<password you set in 03-restore-database.sh>
JWT_SECRET=<run: openssl rand -base64 48   - do not reuse the dev/Coolify secret>
JWT_EXPIRES_IN=1d
# Local VM test (http):
CORS_ORIGINS=http://srilankansqld.org,http://www.srilankansqld.org
# Production (https) - use this line instead after SSL is enabled:
# CORS_ORIGINS=https://srilankansqld.org,https://www.srilankansqld.org
