# Copy to C:\apps\slsq\slsq-backend\.env on the Windows VPS and fill in values.
# Never commit the real file. (The Coolify deployment keeps using its own env vars.)
NODE_ENV=production
PORT=5000
DB_SERVER=localhost
DB_NAME=slsq
DB_USER=slsq_app
DB_PASSWORD=<password from create-app-login.sql>
JWT_SECRET=<new 64+ character random value - do not reuse the dev/Coolify secret>
JWT_EXPIRES_IN=1d
CORS_ORIGINS=https://srilankansqld.org,https://www.srilankansqld.org
